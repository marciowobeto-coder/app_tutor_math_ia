# Copie este arquivo para ".env" (ou use o .env que já existe) e preencha.
# São as chaves PÚBLICAS do projeto Supabase usado pelo app (login, banco e a função de IA).
# Onde achar: painel do Supabase > Project Settings > API.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publica-anon"
VITE_SUPABASE_PROJECT_ID="SEU-PROJETO"
